{
  "championRooms": {
    ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
    "$room": {
      ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && $room.matches(/^[a-f0-9]{32}$/) && ((!data.exists() && newData.child('white').val() === auth.uid && newData.child('members').child(auth.uid).exists()) || (data.child('members').child(auth.uid).exists()) || (data.exists() && newData.child('members').child(auth.uid).exists() && newData.child('white').val() === data.child('white').val()))",
      ".validate": "newData.hasChildren(['visibility','white','black','base','inc','seq','members','state']) && newData.child('visibility').val() === 'public' && newData.child('members').child(newData.child('white').val()).exists() && newData.child('state/pgn').isString() && newData.child('state/pgn').val().length <= 100000"
    }
  },
  "championChat": {
    "$room": {
      ".read": "auth != null && root.child('championRooms').child($room).child('members').child(auth.uid).exists()",
      "$message": {
        ".write": "auth != null && !data.exists() && root.child('championRooms').child($room).child('members').child(auth.uid).exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','name','text']) && newData.child('name').isString() && newData.child('name').val().length <= 50 && newData.child('text').isString() && newData.child('text').val().length <= 500"
      }
    }
  }
}